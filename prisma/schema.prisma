  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([message_type], map: "aljex_message_hist_message_type_index")
  @@index([message_type, message_id], map: "aljex_message_hist_message_type_message_id_index")
}

